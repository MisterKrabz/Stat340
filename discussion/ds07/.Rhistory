return(mean(x))
} else if(type==2){
trimmedX <- x[x<quantile(x, .95) & x>quantile(x, .05)]
return(mean(trimmedX))
} else if(type==3){
return((min(x)+max(x))/2)
} else if(type==4){
trimmedX <- x[x<quantile(x, .95) & x>quantile(x, .05)]
augmentedX <- c(trimmedX,
rep(min(trimmedX),sum(x<=quantile(x, .05))),
rep(max(trimmedX),sum(x>=quantile(x, .95))))
return(mean(augmentedX))
}
}
