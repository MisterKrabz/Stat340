n_simulations <- 100000
sample_size <- 15
true_lambda <- 20
set.seed(2025)
estimates <- replicate(n_simulations, {
sample_data <- rpois(n = sample_size, lambda = true_lambda)
c(mean = mean(sample_data), var = var(sample_data))
})
estimates <- t(estimates)
x_bar_estimates <- estimates[, "mean"]
s_squared_estimates <- estimates[, "var"]
var_xbar <- var(x_bar_estimates)
var_s2 <- var(s_squared_estimates)
cov_xbar_s2 <- cov(x_bar_estimates, s_squared_estimates)
a_optimal <- (var_s2 - cov_xbar_s2) / (var_xbar + var_s2 - 2 * cov_xbar_s2)
a_optimal
