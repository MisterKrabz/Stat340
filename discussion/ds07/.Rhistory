# Return both estimators from the same sample
c(mean = mean(sample_data), var = var(sample_data))
})
# Transpose the results for easier analysis
estimates <- t(estimates)
# Calculate variance and covariance directly from the simulation output
var_xbar <- var(estimates[, "mean"])
var_s2 <- var(estimates[, "var"])
cov_xbar_s2 <- cov(estimates[, "mean"], estimates[, "var"])
# Now, calculate the optimal weight 'a' using the derived values
a_optimal <- (var_s2 - cov_xbar_s2) / (var_xbar + var_s2 - 2 * cov_xbar_s2)
# Print the result
a_optimal
